@model PcShop.Models.Entities.Product
@{
    ViewData["Title"] = Model.Name;
    var priceHistory = ViewBag.PriceHistory as List<PcShop.Models.Entities.PriceHistory>;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Каталог</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Изображение -->
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name" />
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center shadow"
                     style="height: 400px;">
                    <span class="text-muted">Нет изображения</span>
                </div>
            }
        </div>

        <!-- Информация о товаре -->
        <div class="col-md-7">
            <h1>@Model.Name</h1>
            <p class="text-muted">Бренд: @Model.Brand</p>
            <p class="text-muted">Категория: @Model.Category?.Title</p>

            <h2 class="text-success mt-3">@Model.Price.ToString("C")</h2>

            @if (Model.Stock > 0)
            {
                <p class="text-success">✓ В наличии: @Model.Stock шт.</p>
            }
            else
            {
                <p class="text-danger">✗ Нет в наличии</p>
            }

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mt-4">
                    <h4>Описание</h4>
                    <p>@Model.Description</p>
                </div>
            }

            <div class="mt-4">
                <a asp-controller="Configurator" asp-action="Index" class="btn btn-primary btn-lg">
                    🛠️ Добавить в сборку
                </a>
            </div>
        </div>
    </div>

    <!-- История цен -->
    @if (priceHistory != null && priceHistory.Any())
    {
        <div class="card mt-5">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">📈 История цен</h5>
            </div>
            <div class="card-body">
                <canvas id="priceChart" height="100"></canvas>
            </div>
        </div>
    }

    <!-- Отзывы -->
    <div class="card mt-5">
        <div class="card-header bg-warning">
            <h5 class="mb-0">⭐ Отзывы (@Model.Reviews.Count)</h5>
        </div>
        <div class="card-body">
            @if (TempData["ReviewSuccess"] != null)
            {
                <div class="alert alert-success">@TempData["ReviewSuccess"]</div>
            }

            @if (TempData["ReviewError"] != null)
            {
                <div class="alert alert-danger">@TempData["ReviewError"]</div>
            }

            @if (!Model.Reviews.Any())
            {
                <p class="text-muted">Пока нет отзывов. Будьте первым!</p>
            }
            else
            {
                @foreach (var review in Model.Reviews)
                {
                    <div class="border-bottom pb-3 mb-3">
                        <div class="d-flex justify-content-between">
                            <strong>@review.Customer?.Name</strong>
                            <span class="text-warning">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <span>★</span>
                                }
                                @for (int i = review.Rating; i < 5; i++)
                                {
                                    <span class="text-muted">☆</span>
                                }
                            </span>
                        </div>
                        <p class="mb-1 mt-2">@review.Text</p>
                        <small class="text-muted">@review.CreatedAt.ToString("dd.MM.yyyy")</small>
                    </div>
                }
            }

            <!-- Форма добавления отзыва -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                var hasReviewed = Model.Reviews.Any(r => r.CustomerId.ToString() == userId);

                @if (!hasReviewed)
                {
                    <hr>
                    <h5 class="mt-4">Оставить отзыв</h5>
                    <form asp-controller="Review" asp-action="Create" method="post">
                        <input type="hidden" name="ProductId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label">Рейтинг</label>
                            <select name="Rating" class="form-select" required>
                                <option value="">Выберите оценку</option>
                                <option value="5">★★★★★ (5)</option>
                                <option value="4">★★★★☆ (4)</option>
                                <option value="3">★★★☆☆ (3)</option>
                                <option value="2">★★☆☆☆ (2)</option>
                                <option value="1">★☆☆☆☆ (1)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ваш отзыв</label>
                            <textarea name="Text" class="form-control" rows="4"
                                      placeholder="Расскажите о вашем опыте использования товара..."
                                      required minlength="10" maxlength="1000"></textarea>
                            <small class="text-muted">Минимум 10 символов</small>
                        </div>

                        <button type="submit" class="btn btn-primary">Отправить отзыв</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-info mt-3">
                        Вы уже оставили отзыв на этот товар.
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning mt-3">
                    <a asp-controller="Account" asp-action="Login">Войдите</a>, чтобы оставить отзыв.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @if (priceHistory != null && priceHistory.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const ctx = document.getElementById('priceChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(priceHistory.Select(ph => ph.ChangedAt.ToString("dd.MM.yyyy")))),
                    datasets: [{
                        label: 'Цена',
                        data: @Html.Raw(Json.Serialize(priceHistory.Select(ph => ph.Price))),
                        borderColor: 'rgb(75, 192, 192)',
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: false
                        }
                    }
                }
            });
        </script>
    }
}