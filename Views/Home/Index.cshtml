@{
    ViewData["Title"] = "PC Shop — Собери свой ПК";
    var categories = ViewBag.Categories as List<PcShop.Models.Entities.Category>;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4">🖥️ PC Shop</h1>
        <p class="lead">Собери идеальный ПК с автоматической проверкой совместимости</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h3 class="mb-4">Начни сборку прямо сейчас</h3>
                    <p class="text-muted mb-4">
                        Наш конфигуратор автоматически подберёт совместимые компоненты, 
                        проверит сокеты, форм-факторы и мощность блока питания.
                    </p>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Configurator" asp-action="Index" class="btn btn-primary btn-lg me-2">
                            🛠️ Открыть конфигуратор
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-2">
                            🔐 Войти для сборки
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">
                            📝 Регистрация
                        </a>
                    }
                </div>
            </div>

            @if (categories != null && categories.Any())
            {
                <div class="mt-5">
                    <h4 class="mb-3">Категории товаров</h4>
                    <div class="row">
                        @foreach (var cat in categories)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <h5>@cat.Title</h5>
                                        <a asp-controller="Catalog" asp-action="Index" 
                                           asp-route-categoryId="@cat.Id" 
                                           class="btn btn-outline-primary btn-sm">
                                            Смотреть
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>