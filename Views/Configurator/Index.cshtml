@model PcShop.Models.ViewModels.ConfiguratorViewModel
@{
    ViewData["Title"] = "Конфигуратор ПК";
}

<div class="container py-4">
    <h1 class="mb-4">🖥️ Собери свой ПК</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <!-- Левая колонка: выбор компонентов -->
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Выберите компоненты</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" id="categoryTabs">
                        @foreach (var cat in Model.Categories)
                        {
                            <li class="nav-item">
                                <button class="nav-link category-btn"
                                        data-category-id="@cat.Id">
                                    @cat.Title
                                </button>
                            </li>
                        }
                    </ul>

                    <div id="productsList" class="mt-3">
                        <p class="text-muted">Выберите категорию слева</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Правая колонка: текущая сборка -->
        <div class="col-md-4">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Ваша сборка</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Items.Any())
                    {
                        <p class="text-muted">Пока пусто. Начните с процессора!</p>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 p-2 border rounded">
                                <div>
                                    <small class="text-muted">@item.Product!.Category!.Title</small><br>
                                    <strong>@item.Product.Name</strong><br>
                                    <span>@item.Product.Price.ToString("C")</span>
                                </div>
                                <form asp-action="RemoveItem" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">×</button>
                                </form>
                            </div>
                        }

                        <hr>
                        <div class="d-flex justify-content-between">
                            <span>Итого:</span>
                            <strong>@Model.TotalPrice.ToString("C")</strong>
                        </div>
                        <div class="d-flex justify-content-between text-muted small">
                            <span>~Энергопотребление:</span>
                            <span>@Model.TotalTdp W</span>
                        </div>

                        <!-- 👇 БЛОК С ПРЕДУПРЕЖДЕНИЯМИ -->
                        @if (Model.Warnings.Any())
                        {
                            <div class="alert alert-warning mt-3 mb-3">
                                <h6 class="alert-heading">⚠️ Предупреждения</h6>
                                <ul class="mb-0 small">
                                    @foreach (var warning in Model.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        }

                        <form asp-action="Checkout" method="post" class="mt-3">
                            <button type="submit" class="btn btn-success w-100">
                                🛒 Оформить заказ
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.category-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            // Подсветка активной вкладки
            document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const categoryId = btn.dataset.categoryId;
            const response = await fetch(`/Configurator/GetCompatible?categoryId=${categoryId}`);
            const products = await response.json();

            const list = document.getElementById('productsList');

            if (products.length === 0) {
                list.innerHTML = '<p class="text-muted">В этой категории пока нет товаров</p>';
                return;
            }

            list.innerHTML = products.map(p => {
                const disabledAttr = p.isCompatible ? '' : 'disabled';
                const cardClass = p.isCompatible ? '' : 'opacity-75';
                const badgeHtml = p.isCompatible
                    ? '<span class="badge bg-success">✓ Совместим</span>'
                    : `<span class="badge bg-danger">✗ Не совместим</span>`;

                const reasonHtml = p.isCompatible
                    ? ''
                    : `<div class="alert alert-danger small py-1 px-2 mt-2 mb-0">
                         <strong>Причина:</strong> ${p.reason}
                       </div>`;

                const stockHtml = p.stock > 0
                    ? `<span class="badge bg-success">В наличии: ${p.stock}</span>`
                    : `<span class="badge bg-danger">Нет в наличии</span>`;

                const outOfStockDisabled = p.stock > 0 ? '' : 'disabled';

                return `
                    <div class="card mb-2 ${cardClass}">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <strong>${p.name}</strong>
                                        ${badgeHtml}
                                    </div>
                                    <small class="text-muted">${p.brand}</small><br>
                                    <span class="text-success fw-bold">${p.price.toLocaleString('ru-RU')} ₽</span>
                                    <div class="mt-1">${stockHtml}</div>
                                    ${reasonHtml}
                                </div>
                                <form action="/Configurator/AddItem" method="post" class="ms-2">
                                    <input type="hidden" name="productId" value="${p.id}" />
                                    <button type="submit" class="btn btn-primary"
                                            ${disabledAttr} ${outOfStockDisabled}
                                            title="${p.isCompatible ? (p.stock > 0 ? 'Добавить в сборку' : 'Нет в наличии') : 'Товар не совместим'}">
                                        +
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        });
    });

    // Автовыбор первой категории при загрузке
    const firstBtn = document.querySelector('.category-btn');
    if (firstBtn) firstBtn.click();
</script>

<style>
    .category-btn.active {
        font-weight: bold;
        color: #0d6efd;
        border-bottom: 2px solid #0d6efd;
    }
    .category-btn {
        background: none;
        border: none;
        padding: 0.5rem 1rem;
        cursor: pointer;
    }
    .category-btn:hover {
        color: #0d6efd;
    }
</style>
}