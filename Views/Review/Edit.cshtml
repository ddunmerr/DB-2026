@model PcShop.Models.ViewModels.ReviewEditViewModel
@{
    ViewData["Title"] = "Редактирование отзыва";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">✏️ Редактирование отзыва</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Товар: <strong>@Model.ProductName</strong>
                    </p>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ProductId" />
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">Оценка</label>
                            <div class="rating-input">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" asp-for="Rating" value="@i" id="star_@i" />
                                    <label for="star_@i" class="star">★</label>
                                }
                            </div>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Text" class="form-label">Текст отзыва</label>
                            <textarea asp-for="Text" class="form-control" rows="5" 
                                      placeholder="Расскажите о вашем опыте использования..."></textarea>
                            <span asp-validation-for="Text" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Product" asp-action="Details" 
                               asp-route-id="@Model.ProductId" 
                               class="btn btn-secondary">← Отмена</a>
                            <button type="submit" class="btn btn-primary">💾 Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rating-input {
        display: flex;
        flex-direction: row-reverse; /* Критически важно: визуально разворачивает 5-4-3-2-1 в 1-2-3-4-5 */
        justify-content: flex-start;
    }

        .rating-input input {
            display: none; /* Прячем сами кружочки радио-кнопок */
        }

        .rating-input .star {
            font-size: 2rem;
            color: #ddd;
            cursor: pointer;
            transition: color 0.2s;
        }

            /* При наведении: красим эту звезду и все звезды, которые в HTML идут ПОСЛЕ неё (визуально это звезды слева) */
            .rating-input .star:hover,
            .rating-input .star:hover ~ .star {
                color: #ffc107;
            }

        /* При клике (выборе): красим эту звезду и все звезды, которые в HTML идут ПОСЛЕ неё */
        .rating-input input:checked ~ .star {
            color: #ffc107;
        }
</style>